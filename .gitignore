# Jekyll build output & caches
_site/
.jekyll-cache/
.jekyll-metadata

# Bundler (when running natively rather than in Docker)
vendor/
.bundle/
Gemfile.lock

# OS / editor cruft
.DS_Store
Thumbs.db

# Local Claude Code state, except the redesign plan, which is worth keeping.
# (It has to be `.claude/*`, not `.claude/`: git cannot re-include a file whose
#  parent directory is itself excluded.)
.claude/*
!.claude/REDESIGN-PLAN.md
