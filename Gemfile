source "https://rubygems.org"

# Jekyll 4.x — matches the version used by the GitHub Actions build so local
# and production output are identical.
gem "jekyll", "~> 4.3"

# Required to run `jekyll serve` on Ruby 3+ (WEBrick was removed from stdlib).
gem "webrick", "~> 1.8"

group :jekyll_plugins do
  gem "jekyll-seo-tag", "~> 2.8"
  gem "jekyll-sitemap", "~> 1.4"
end
